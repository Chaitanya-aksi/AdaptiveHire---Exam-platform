# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
# Host-side API port. 3001 rather than 3000 to sidestep other local dev servers.
PORT=3001

# Comma-separated list of allowed browser origins (the Vite dev server).
# AdaptiveHire's frontend is pinned to 5174 (KhetPilot owns 5173).
CORS_ORIGIN=http://localhost:5174

# ── PostgreSQL ─────────────────────────────────────────────────────────────
# POSTGRES_HOST is "localhost" when the API runs on the host and "postgres"
# when it runs inside docker compose (compose overrides it for you).
# POSTGRES_PORT is the HOST-side port only. Inside compose it is always 5432;
# 5434 here just avoids other Postgres instances already on 5432/5433.
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_USER=adaptivehire
POSTGRES_PASSWORD=adaptivehire
POSTGRES_DB=adaptivehire

# Managed Postgres refuses plaintext connections; local compose has no
# certificate to offer. Set true for any hosted database.
POSTGRES_SSL=false

# The provider's CA certificate, so the server is verified and not merely
# encrypted. Accepts raw PEM or base64 of the same — prefer base64, because a
# PEM's newlines rarely survive a hosting dashboard's env-var field:
#   base64 -w0 ca.pem          (Linux)
#   certutil -encode ca.pem out.txt   (Windows, then strip the header lines)
# Left blank the connection is still encrypted, but the server is
# unauthenticated. Fine over docker compose, not over the public internet.
POSTGRES_CA_CERT=

# Connections this process may open. 10 is TypeORM's own default and the right
# value locally. Lower it to 5 on a hosted deployment: free managed plans cap
# connections server-side and offer no pooler, so 10 here plus a migration run
# from your laptop reaches a 20-connection ceiling, where further connections
# are refused rather than queued.
#
# Do not run below ~10 locally. Each /auth/refresh holds a connection through a
# 64 MiB argon2 hash, so a small pool queues under concurrent auth load and the
# e2e refresh suite can no longer drain its pool within the teardown window.
POSTGRES_POOL_MAX=10

# ── Redis (session state, timer TTL keys, BullMQ) ──────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# Managed providers hand you one URL with credentials in it. When set this wins
# over REDIS_HOST/REDIS_PORT above, and `rediss://` (two s) turns TLS on.
# Applies to the app's own client and to every BullMQ connection alike.
REDIS_URL=

# Key namespace for every BullMQ queue. Leave this alone for real work.
#
# A queue belongs to whoever shares its Redis AND its prefix: any worker
# matching both will consume jobs enqueued by anyone else, regardless of how
# that other process was configured. The e2e suite sets its own prefix for
# exactly this reason — without it, test invitations to @e2e.local were picked
# off the shared queue by a running dev server and sent through real SMTP.
#
# Change it only to isolate one environment's jobs from another's on a single
# Redis. Changing it on a live system orphans whatever is already queued.
BULL_PREFIX=bull

# ── Auth ───────────────────────────────────────────────────────────────────
# Generate real values before anything leaves your machine:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_TTL=7d

# Refresh tokens rotate on every use. This is how long the token that was just
# replaced stays acceptable, so a page reload racing an in-flight rotation does
# not get signed out. Reuse of a token that was never current still revokes the
# session immediately. Set to 0 for strict single-use rotation.
AUTH_REFRESH_GRACE_SECONDS=30

# Refresh tokens are sent as httpOnly cookies; set to true behind HTTPS.
COOKIE_SECURE=false

# lax | strict | none. Use `none` only when the SPA and the API are on
# different sites — the browser withholds a `lax` cookie there without raising
# any error, so login appears to work and every session dies on the next page
# load. `none` requires COOKIE_SECURE=true and the app refuses to boot without
# it. If both sides share one registrable domain (app.example.com and
# api.example.com) they are same-site and `lax` keeps working — prefer that.
COOKIE_SAMESITE=lax

# ── Rate limiting (@nestjs/throttler) ──────────────────────────────────────
# Set true when running behind a hosting platform's proxy, so the throttler
# reads the real client address from X-Forwarded-For. Left false there, the
# proxy's own address is counted for every request and the limits below become
# one bucket shared by every candidate at once. Keep false for local runs.
TRUST_PROXY=false

THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# ── App / email (invitations) ──────────────────────────────────────────────
# Where the frontend is served — used to build the register link in invites.
APP_URL=http://localhost:5174

# Fallback address candidates are given when an assessment goes wrong for them
# — a power cut, a dropped connection — so they can ask for another attempt.
# Each organisation can set its own from Settings → Branding, which wins over
# this; this only covers organisations that have not. Leave blank and the
# candidate UI shows no contact route at all, which beats one that goes nowhere.
SUPPORT_EMAIL=

# SMTP for invite emails. Leave MAIL_HOST blank in dev: the invite-emails
# worker then logs the rendered email to the console instead of sending it,
# so the whole flow is testable without a mail account. Fill these in to send
# for real — no code change needed.
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=AdaptiveHire <no-reply@adaptivehire.local>

# ── Observability ──────────────────────────────────────────────────────────
# Log verbosity: fatal|error|warn|info|debug|trace|silent.
# Unset means debug in development and info in production.
LOG_LEVEL=

# Error tracking. Leave empty to turn it off entirely — nothing is sent and
# nothing is required to boot. Set it to a Sentry DSN to enable.
SENTRY_DSN=
SENTRY_RELEASE=
# Performance tracing is off by default: sampled URLs contain session and
# candidate ids, so switching it on should be a deliberate decision.
SENTRY_TRACES_SAMPLE_RATE=0

# Frontend error tracking (Vite exposes only VITE_-prefixed vars to the client).
VITE_SENTRY_DSN=
